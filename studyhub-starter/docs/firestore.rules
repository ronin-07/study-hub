// Only apply these rules in a DEDICATED Study Hub Firebase project.
// All Firestore access is through the verified FastAPI backend with Firebase Admin SDK.
// Do not replace the RepLap project's Firestore rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
