# Reference only: the backend does not auto-load .env files.
# Set process variables explicitly; local-only mode, never bind publicly.
STUDY_HUB_AUTH_MODE=local
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/studyhub.sqlite3
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional local Drive configuration: use separate test credentials only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/drive/callback
# WEB_URL=http://127.0.0.1:3000
# APP_SIGNING_SECRET=
# OAUTH_ENCRYPTION_KEY=
