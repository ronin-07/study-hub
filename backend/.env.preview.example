# Example only; never commit actual credential values.
# Vercel injects VERCEL=1 and VERCEL_ENV=preview automatically.
STUDY_HUB_AUTH_MODE=firebase
STORAGE_BACKEND=firestore
STUDY_HUB_ALLOWED_EMAIL=you@example.com
STUDY_HUB_PREVIEW_FIREBASE_PROJECT_ID=studyhub-preview-example
STUDY_HUB_PRODUCTION_FIREBASE_PROJECT_ID=studyhub-production-example
# FIREBASE_SERVICE_ACCOUNT_JSON = JSON for PREVIEW Firebase project only
# Drive OAuth disabled unless specifically configured with separate PREVIEW credentials.
# STUDY_HUB_ALLOW_PREVIEW_DRIVE_OAUTH=false
