# Reference only; do not copy this file as a real hosted configuration.
# Configure these values in Vercel Preview scope with dedicated test credentials.
STUDY_HUB_AUTH_MODE=firebase
STORAGE_BACKEND=firestore
STUDY_HUB_PREVIEW_FIREBASE_PROJECT_ID=replace-with-preview-project-id
STUDY_HUB_PRODUCTION_FIREBASE_PROJECT_ID=replace-with-production-project-id
NEXT_PUBLIC_FIREBASE_PROJECT_ID=replace-with-preview-project-id
# Set at least one owner restriction; both are enforced if supplied.
# STUDY_HUB_ALLOWED_UID=
# STUDY_HUB_ALLOWED_EMAIL=
# FIREBASE_SERVICE_ACCOUNT_JSON=
STUDY_HUB_ALLOW_PREVIEW_DRIVE_OAUTH=false
# Drive is disabled by default. Do not use production OAuth configuration.
